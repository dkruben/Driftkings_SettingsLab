!/mod/res/audioww/*.bnk

# Native helpers and exact WOTMOD staging
/installer/build/
/build/staging/
/build_data/toolchain.local.json

# Local verification fixtures; excluded from source publication
/build_tools/tests/
/build_tools/common_startup_probe_py27.py

# Local tool caches
test/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Project Markdown documentation; keep local research data and scripts excluded.
/docs/**
!/docs/**/
!/docs/**/*.md

# Runtime, frontend, build and artifact tests are source-controlled.
!/tests/
/tests/**
!/tests/**/
!/tests/**/*.py
!/tests/**/*.js
!/tests/fixtures/*.json
/tests/**/__pycache__/
/tests/**/node_modules/

# Installer artwork is supplied locally; keep directory markers and guides tracked.
/installer/setup/assets/branding/*.png
/installer/setup/assets/branding/*.bmp
/installer/setup/assets/branding/*.ico
/installer/setup/assets/previews/*.png

# Private release-signing seed; only the public verification key is tracked.
/release-signing.key

# Generated authoring artefacts; source WAV/WWU/WPROJ files remain tracked.
/res/sound_bank_wwise/sixthsense/.cache/
/res/sound_bank_wwise/sixthsense/GeneratedSoundBanks/
/res/sound_bank_wwise/sixthsense/**/Wwise.dat
/res/.mtimes*
# The battle movie is generated from flash_source; do not restore an old binary here.
/mod/res/gui/flash/driftkingsbattle.swf
