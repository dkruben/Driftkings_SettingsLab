{
  "clock": {
    "enabled": true,
    "formats": [
      {
        "x": -10,
        "y": 80,
        "width": 200,
        "height": 50,
        "screenHAlign": "right",
        "shadow": {
          "enabled": true,
          "distance": 0,
          "angle": 0,
          "color": "#000000",
          "alpha": 70,
          "blur": 4,
          "strength": 2
        },
        "textFormat": {
          "align": "right",
          "valign": "bottom",
          "color": "#D8D5CD"
        },
        "format": "<font face='$FieldFont'><textformat leading='-38'><font size='28' color='#D8D5CD'>%H:%M</font><br></textformat><textformat leading='-2'><font size='15' color='#959688'>%d %b %Y</font></textformat></font>"
      }
    ]
  },
  "enabled": true
}
