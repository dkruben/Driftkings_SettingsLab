{
  "playersPanel": {
    "alpha": 80,
    "altMode": null,
    "enabled": true,
    "iconAlpha": 100,
    "removeHealthPoints": true,
    "removePanelsModeSwitcher": false,
    "removeSelectedBackground": false,
    "showUnavailable": true,
    "startMode": "medium2"
  },
  "templates": {
    "enemySpottedMarker": {
      "bindToIcon": true,
      "enabled": "{{.spottedEnabled}}",
      "height": 22,
      "src": "img://gui/maps/driftkings/playerpanelpro/spotted/{{alive?{{spotted|neverSeen}}|dead}}.png",
      "width": 22,
      "x": -38,
      "y": 0
    },
    "hp": {
      "bindToIcon": true,
      "format": "{{hp}}/{{hp-max}}",
      "shadow": {
        "alpha": 90,
        "angle": 0,
        "blur": 2,
        "color": "#000000",
        "distance": 0,
        "enabled": true,
        "strength": 2
      },
      "textFormat": {
        "align": "center",
        "color": "#FFFFFF",
        "font": "$FieldFont",
        "size": 11
      },
      "width": 72,
      "x": "{{ally?75|79}}",
      "y": 3
    },
    "hpBar": {
      "bindToIcon": true,
      "enabled": "{{hp>0?true|false}}",
      "height": 14,
      "src": "img://gui/maps/driftkings/playerpanelpro/hp/hp_alive_{{ally?l|{{colorblind?r_cb|r}}}}.png",
      "width": "{{hp-ratio:72}}",
      "x": "{{ally?75|79}}",
      "y": 3
    },
    "hpBarBg": {
      "bindToIcon": true,
      "height": 12,
      "src": "img://gui/maps/driftkings/playerpanelpro/hp/hp_bg.png",
      "width": 70,
      "x": "{{ally?76|80}}",
      "y": 4
    }
  }
}
