# Generated local audit snapshots and visual previews
audit_mods/*.json
previews/*.png
flash_source/**/obj/

# Banks embedded in the unified package
!/mod/res/audioww/*.bnk

# Native helpers and exact WOTMOD staging
/installer/build/
/build/staging/
/build_data/toolchain.local.json

# Local verification fixtures; excluded from source publication
/build_tools/tests/
/build_tools/common_startup_probe_py27.py

# Local test suites and tool caches
tests/
test/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Project Markdown documentation; keep local research data and scripts excluded.
/docs/**
!/docs/**/
!/docs/**/*.md

# Pure settings-panel regression tests are part of the source project.
!/tests/
/tests/*
!/tests/settings_panel/
/tests/settings_panel/*
!/tests/settings_panel/test_*.py
!/tests/settings_panel/test_*.js

# Portable Core regression tests are also source-controlled.
!/tests/core/
/tests/core/*
!/tests/core/*.py
!/tests/core/fixtures/
/tests/core/fixtures/*
!/tests/core/fixtures/wnx_reference.json

# Shared fixtures read by both the Python and the JavaScript marker tests.
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/vehicle_marker_conditions.json

# Build-time installer generation and media validation tests.
!/tests/installer/
/tests/installer/*
!/tests/installer/*.py

# Installer artwork is supplied locally; keep directory markers and guides tracked.
/installer/setup/assets/branding/*.png
/installer/setup/assets/branding/*.bmp
/installer/setup/assets/branding/*.ico
/installer/setup/assets/previews/*.png

# Private release-signing seed; only the public verification key is tracked.
/release-signing.key
