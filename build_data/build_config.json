      "swf_version": 14,
      "width": 1024,
      "height": 768,
      "fps": 30
    },
    "carousel_bridge": {
      "kind": "gameface_patch",
      "resource": "gui/gameface/_dist/production/mono/hangar/main/bundle.js",
      "game_packages": [
        "res/packages/gui-part1.pkg",
        "res/packages/gui-part2.pkg",
        "res/packages/gui-part3.pkg",
        "res/packages/gui-part4.pkg"
      ],
      "output": "build/gameface/carousel/bundle.js",
      "implementation": "replace_exact",
      "required": true,
      "patch_file": "build_data/patches/carousel_2.4.1.json"
    },
    "updater_helper": {
      "kind": "csharp",
      "source": "installer/source/installer.cs",
      "additional_sources": [
        "installer/source/modpackinstaller.cs",
        "installer/source/exitwork.cs"
      ],
      "output": "build/native/updater/Driftkings.UpdateInstaller.exe",
      "metadata": "build/native/updater/helper.json",
      "references": [
        "System.Web.Extensions.dll",
        "System.IO.Compression.dll"
      ]
    },
    "windows_files_helper": {
      "kind": "csharp",
      "source": "installer/source/windowsfiles.cs",
      "output": "build/native/windows-files/Driftkings.WindowsFiles.exe",
      "metadata": "build/native/windows-files/helper.json",
      "references": []
    },
    "fog_package_helper": {
      "kind": "csharp",
      "source": "installer/source/fogpackage.cs",
      "output": "build/native/fog/Driftkings.FogPackage.exe",
      "metadata": "build/native/fog/helper.json",
      "references": [
        "System.IO.Compression.dll"
      ],
      "additional_sources": [
        "installer/source/exitwork.cs"
      ]
    },
    "crew_barracks_bridge": {
      "kind": "gameface_patch",
      "resource": "gui/gameface/_dist/production/lobby/crew/BarracksView/BarracksView.js",
      "game_packages": [
        "res/packages/gui-part1.pkg",
        "res/packages/gui-part2.pkg",
        "res/packages/gui-part3.pkg",
        "res/packages/gui-part4.pkg"
      ],
      "output": "build/gameface/crew/BarracksView.js",
      "implementation": "replace_exact",
      "required": true,
      "patch_file": "build_data/patches/crew_barracks_2.4.1.json"
    },
    "crew_tooltip_bridge": {
      "kind": "gameface_patch",
      "resource": "gui/gameface/_dist/production/mono/hangar/tooltips/bundle.js",
      "game_packages": [
        "res/packages/gui-part1.pkg",
        "res/packages/gui-part2.pkg",
        "res/packages/gui-part3.pkg",
        "res/packages/gui-part4.pkg"
      ],
      "output": "build/gameface/crew/tooltips.js",
      "implementation": "replace_exact",
      "required": true,
      "patch_file": "build_data/patches/crew_tooltip_2.4.1.json"
    },
    "vehicle_markers_flash": {
      "kind": "vehicle_markers",
      "entrypoint": "flash_source/vehicle_markers/DriftkingsVehicleMarkersFlash.as",
      "lock": "flash_source/vehicle_markers/native-lock.json",
      "output": "build/flash/driftkings_vehicle_markers.swf"
    }
  }
