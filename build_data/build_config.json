      "ASIA"
    ],
    "root": "D:/Games/World_of_Tanks_NA"
  },
  "reference": {
    "version": "2.4.1.5504",
    "root": "E:/Wot_Mods_/Drift_Kings_ModPack/WoT_Tools/wot-src-EU",
    "read_only": true
  },
  "package": {
    "name": "driftkings.wotmod",
    "output": "build/unified/driftkings.wotmod",
    "compression": "stored",
    "release_root": "build/releases",
    "debug_root": "build/debug"
  },
  "components": {
    "source": "build_data/components.json"
  },
  "python": {
    "version": "2.7",
    "source_root": "mod/res/scripts/client",
    "staging_root": "build/staging/res/scripts/client",
    "archive_root": "res/scripts/client",
    "include": [
      "**/*.py"
    ],
    "entrypoint": "gui/mods/mod_driftkings.py",
    "component_list": "driftkings/component_list.py",
    "optimize": 0,
    "additional_roots": [
      {
        "source_root": "mod/res/mods/openwg_packages",
        "archive_root": "res/mods/openwg_packages",
        "staging_root": "build/staging/res/mods/openwg_packages",
        "include": [
          "**/*.py"
        ]
      }
    ]
  },
  "assets": {
    "exclude": [
      "**/readme.md",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.bak"
    ]
  },
  "defaults": {
    "source_root": "res/configs/driftkings",
    "install_root": "mods/configs/driftkings",
    "include": [
      "load.json",
      "default/**/*.json"
    ],
    "install_policy": "missing_only",
    "in_wotmod": false
  },
  "ui_dependencies": {
    "directory": "res/wotmods",
    "files": [
      {
        "name": "me.poliroid.modslistapi_1.8.0.wotmod",
        "sha256": "c6e4a1d9476b0195c3b4fab392cf5d68c00f1d02fd79e29bd7424ebda88b498c"
      },
      {
        "name": "net.openwg.gameface_1.2.2.wotmod",
        "sha256": "2bb65f28663e3ab34b5a1102a1bbd1f6e17a65e1f6a898a8645c4ab732b50184"
      },
      {
        "name": "net.openwg.common_2.8.5.0000.wotmod",
        "sha256": "f4680bb95857a7cbdb594ff7318c07784459fe5c316a52cb6a9f06c5b7917f37"
      }
    ]
  },
  "generators": {
    "battle_flash": {
      "kind": "flash",
      "entrypoint": "flash_source/battle/src/driftkingsbattle.as",
      "source_paths": [
        "flash_source/battle/src",
        "flash_source/shared/as3"
      ],
      "library_manifest": "flash_source/shared/swc/manifest.json",
      "output": "build/flash/driftkingsbattle.swf",
